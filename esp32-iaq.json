      {
        "additionalInfo": {
          "layoutX": 920,
          "layoutY": 820
        },
        "type": "org.thingsboard.rule.engine.filter.TbJsFilterNode",
        "name": "ANY_OUT_OF_RANGE",
        "debugMode": true,
        "singletonMode": false,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "TBEL",
          "jsScript": "return true;",
          "tbelScript": "var tempOk = msg.bme_temp_c == null || (msg.bme_temp_c >= 20 && msg.bme_temp_c <= 25);\nvar humOk  = msg.bme_hum_pct == null || (msg.bme_hum_pct >= 40 && msg.bme_hum_pct <= 60);\nvar co2Ok  = msg.sgp30_eco2_ppm == null || (msg.sgp30_eco2_ppm >= 400 && msg.sgp30_eco2_ppm <= 800);\nvar tvocOk = msg.sgp30_tvoc_ppb == null || (msg.sgp30_tvoc_ppb < 300);\nvar luxOk  = msg.bh1750_lux == null || (msg.bh1750_lux >= 300 && msg.bh1750_lux <= 500);\nvar noiseOk = msg.spm1423_noise_db == null || (msg.spm1423_noise_db < 40);\nvar allOk = tempOk && humOk && co2Ok && tvocOk && luxOk && noiseOk;\nreturn !allOk;"
        },
        "externalId": null
      },
      {
        "additionalInfo": {
          "layoutX": 1227,
          "layoutY": 776
        },
        "type": "org.thingsboard.rule.engine.transform.TbTransformNode",
        "name": "To ALERT RPC",
        "debugMode": true,
        "singletonMode": false,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "JS",
          "jsScript": "// Reutilizar las mismas condiciones del filtro ANY_OUT_OF_RANGE\nvar tempOk  = msg.bme_temp_c == null || (msg.bme_temp_c >= 20 && msg.bme_temp_c <= 25);\nvar humOk   = msg.bme_hum_pct == null || (msg.bme_hum_pct >= 40 && msg.bme_hum_pct <= 60);\nvar co2Ok   = msg.sgp30_eco2_ppm == null || (msg.sgp30_eco2_ppm >= 400 && msg.sgp30_eco2_ppm <= 800);\nvar tvocOk  = msg.sgp30_tvoc_ppb == null || (msg.sgp30_tvoc_ppb < 300);\nvar luxOk   = msg.bh1750_lux == null || (msg.bh1750_lux >= 300 && msg.bh1750_lux <= 500);\nvar noiseOk = msg.spm1423_noise_db == null || (msg.spm1423_noise_db < 40);\n\n// Construir lista de fallas reales\nvar issues = [];\n\nif (!tempOk) {\n  if (msg.bme_temp_c < 20) {\n    issues.push(\"TEMP BAJA\");\n  } else if (msg.bme_temp_c > 25) {\n    issues.push(\"TEMP ALTA\");\n  }\n}\n\nif (!humOk) {\n  if (msg.bme_hum_pct < 40) {\n    issues.push(\"HUM BAJA\");\n  } else if (msg.bme_hum_pct > 60) {\n    issues.push(\"HUM ALTA\");\n  }\n}\n\nif (!co2Ok) {\n  if (msg.sgp30_eco2_ppm < 400) {\n    issues.push(\"CO2 BAJO\");\n  } else if (msg.sgp30_eco2_ppm > 800) {\n    issues.push(\"CO2 ALTO\");\n  }\n}\n\nif (!tvocOk) {\n  issues.push(\"TVOC ALTO\");\n}\n\nif (!luxOk) {\n  if (msg.bh1750_lux < 300) {\n    issues.push(\"LUZ BAJA\");\n  } else if (msg.bh1750_lux > 500) {\n    issues.push(\"LUZ ALTA\");\n  }\n}\n\nif (!noiseOk) {\n  issues.push(\"RUIDO ALTO\");\n}\n\n// Selección final para OLED (máx 2 líneas cortas)\nvar line1 = \"ALERTA\";\nvar line2 = \"REVISA SALA\";\n\nif (issues.length === 1) {\n  line1 = issues[0];\n  line2 = \"\";\n} else if (issues.length >= 2) {\n  line1 = issues[0];\n  line2 = issues[1];\n}\n\n// RPC final\nvar newMsg = {\n  method: \"setIndicators\",\n  params: {\n    ledGreen: false,\n    ledRed: true,\n    buzzerMs: 200,\n    oledLine1: line1,\n    oledLine2: line2,\n    bme_temp_c: msg.bme_temp_c,\n    bme_hum_pct: msg.bme_hum_pct,\n    sgp30_eco2_ppm: msg.sgp30_eco2_ppm,\n    sgp30_tvoc_ppb: msg.sgp30_tvoc_ppb,\n    bh1750_lux: msg.bh1750_lux,\n    spm1423_noise_db: msg.spm1423_noise_db\n  }\n};\n\nreturn {\n  msg: newMsg,\n  metadata: metadata,\n  msgType: \"RPC_CALL_FROM_SERVER_TO_DEVICE\"\n};",
          "tbelScript": null
        },
        "externalId": null
      },
      {
        "additionalInfo": {
          "layoutX": 1227,
          "layoutY": 1016
        },
        "type": "org.thingsboard.rule.engine.transform.TbTransformNode",
        "name": "To OK RPC",
        "debugMode": true,
        "singletonMode": false,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "JS",
          "jsScript": "// Mensaje RPC hacia el dispositivo en estado OK\nvar newMsg = {\n  method: \"setIndicators\",\n  params: {\n    ledGreen: true,\n    ledRed: false,\n    buzzerMs: 0,\n    oledLine1: \"CONDICION OK\",\n    oledLine2: \"Ambiente estable\",\n    bme_temp_c: msg.bme_temp_c,\n    bme_hum_pct: msg.bme_hum_pct,\n    sgp30_eco2_ppm: msg.sgp30_eco2_ppm,\n    sgp30_tvoc_ppb: msg.sgp30_tvoc_ppb,\n    bh1750_lux: msg.bh1750_lux,\n    spm1423_noise_db: msg.spm1423_noise_db\n  }\n};\n\nreturn {\n  msg: newMsg,\n  metadata: metadata,\n  msgType: \"RPC_CALL_FROM_SERVER_TO_DEVICE\"\n};",
          "tbelScript": null
        },
        "externalId": null
